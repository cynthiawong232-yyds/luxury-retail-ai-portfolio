# ─────────────────────────────────────────────────────────────────────────
# Streamlit secrets template
#
# Two ways to use this file:
#
# 1. LOCAL DEV — copy this to `.streamlit/secrets.toml` (NOT committed; the
#    real file is in .gitignore) and paste your Groq API key. Streamlit will
#    auto-load it and expose values as env vars AND via st.secrets[].
#
# 2. STREAMLIT COMMUNITY CLOUD — paste these contents (with your real key)
#    into your app's "Secrets" UI:
#       Manage app → Settings → Secrets
#    Streamlit Cloud injects them as env vars at runtime.
#
# Get a free Groq key at: https://console.groq.com/keys
# ─────────────────────────────────────────────────────────────────────────

GROQ_API_KEY = "gsk_paste_your_rotated_key_here"

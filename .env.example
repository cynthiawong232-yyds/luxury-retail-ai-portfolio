# ─────────────────────────────────────────────────────────────────────────
# Local environment template (NOT committed — see .gitignore)
#
# 1. Copy this file:        cp .env.example .env
# 2. Paste your rotated Groq key into the line below.
# 3. Run:                   streamlit run main.py
#
# main.py and every sub-app call load_dotenv() and pick this up automatically.
#
# On Streamlit Community Cloud, you do NOT need a .env file — paste the same
# key into the app's Secrets UI instead. See .streamlit/secrets.toml.example.
# ─────────────────────────────────────────────────────────────────────────

GROQ_API_KEY=gsk_paste_your_rotated_key_here
